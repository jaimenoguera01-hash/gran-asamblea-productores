type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type SendOutcome = 
 variant {
   failed: text;
   noRecipients;
   sent: record {recipients: nat;};
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ReminderInfo = 
 record {
   notice: text;
   recipientCount: nat;
   scheduledAt: Timestamp;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type AttendanceInput = 
 record {
   cedula: text;
   email: text;
   fullName: text;
   municipio: text;
   parroquia: text;
   phone: text;
 };
type AttendanceId = nat;
type Attendance = 
 record {
   cedula: text;
   email: text;
   fullName: text;
   id: AttendanceId;
   municipio: text;
   parroquia: text;
   phone: text;
   registeredAt: Timestamp;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Read the reminder's scheduled date/time, notice text and recipient count.
  /// Administrator only.
  getReminderInfo: () -> (ReminderInfo) query;
  isCallerAdmin: () -> (bool) query;
  /// Return all attendance registrations so the page can export them as a table.
  listAttendance: () -> (vec Attendance) query;
  /// Register attendance for the event. Open to any visitor, no sign-in required.
  registerAttendance: (input: AttendanceInput) -> (Attendance);
  schema: () -> (text) query;
  /// Trigger the reminder immediately. Administrator only.
  sendReminderNow: () -> (SendOutcome);
}
